    "source:1d5ea4c7c5": {
      "id": "source:1d5ea4c7c5",
      "type": "source",
      "url": "https://www.instagram.com/reel/Dfk9FlGP7DY/",
      "title": "ChatGPT business profiles",
      "author": "@edward.builds",
      "kind": "transcript",
      "addedAt": "2026-11-22T16:30:52.305Z"
    },
    "insight:c1ebe3c482": {
      "id": "insight:c1ebe3c482",
      "type": "insight",
      "text": "Claim your business profile within ChatGPT's Business Hub to enhance visibility and interaction with potential customers.",
      "how": "Navigate to chatgpt.com/business-hub, search for your business, and click the plus button to add it.",
      "quote": "You can claim your business, keep everything up to date, get insights.",
      "at": null,
      "tags": [
        "Tool",
        "ChatGPT",
        "Business Hub"
      ]
    },
    "insight:0486c6a8fa": {
      "id": "insight:0486c6a8fa",
      "type": "insight",
      "text": "Utilize ChatGPT Business Agents to answer customer questions and help them explore your offerings directly within ChatGPT.",
      "how": "Once your business is claimed, the business agent can be configured to interact with users.",
      "quote": "Businesses can interact with users via business agents.",
      "at": null,
      "tags": [
        "Tool",
        "ChatGPT",
        "Business Agent"
      ]
    },
    "insight:d15ee98ca4": {
      "id": "insight:d15ee98ca4",
      "type": "insight",
      "text": "Monitor insights from your ChatGPT business profile, including mentions, website clicks, and discovery topics, to understand customer engagement.",
      "how": "The Business Hub provides data on common themes in conversations where your website is cited.",
      "quote": "Insights you get: number of mentions, website clicks, discovery topics—common themes across conversations where the website is cited.",
      "at": null,
      "tags": [
        "Analytics",
        "ChatGPT",
        "Business Hub"
      ]
    },
    "source:5a7f571ca8": {
      "id": "source:5a7f571ca8",
      "type": "source",
      "url": "https://www.instagram.com/reel/Df--4CtAgrf/",
      "title": "Sites that make AI-built websites look good",
      "author": "@hugomxnning",
      "kind": "transcript",
      "addedAt": "2026-11-22T16:30:55.549Z"
    },
    "domain:design": {
      "id": "domain:design",
      "type": "domain",
      "name": "Design"
    },
    "skill:giving-ai-design-taste": {
      "id": "skill:giving-ai-design-taste",
      "type": "skill",
      "name": "Giving AI design taste",
      "domain": "Design",
      "description": "Strategies and resources to enhance the aesthetic quality and design sophistication of AI-generated content and websites.",
      "updatedAt": "2026-11-22T16:30:58.563Z"
    },
    "insight:2fbe705e04": {
      "id": "insight:2fbe705e04",
      "type": "insight",
      "text": "Collect inspiration from specialized websites to improve the design quality of AI-built websites.",
      "how": "Use sites like 21st.dev, Originkit, and Spell UI for components; Kawaii, Kinetics, and Animation Dictionary for text animation; Fontshare, Fonts In Use, and Fontesk for fonts.",
      "quote": "The people who are getting the best AI websites and designs are not better at prompting or have some special skill. They're better at collecting inspiration.",
      "at": null,
      "tags": [
        "inspiration",
        "design tools",
        "AI design"
      ]
    },
    "insight:17fc4116d1": {
      "id": "insight:17fc4116d1",
      "type": "insight",
      "text": "Utilize specific platforms for 3D and scroll website inspiration.",
      "how": "Explore Scrolltide, GetLayers, and MotionSites for ideas on 3D and scroll effects.",
      "quote": null,
      "at": null,
      "tags": [
        "3D design",
        "scroll effects",
        "design tools"
      ]
    },
    "insight:801dd12005": {
      "id": "insight:801dd12005",
      "type": "insight",
      "text": "Find color palettes and schemes using dedicated inspiration sites.",
      "how": "Browse Pinterest and Coolors for color ideas.",
      "quote": null,
      "at": null,
      "tags": [
        "color palette",
        "design tools"
      ]
    },
    "insight:17813d8e1f": {
      "id": "insight:17813d8e1f",
      "type": "insight",
      "text": "Gather inspiration for website sections and detailed elements.",
      "how": "Check Unsection, details.so, and Supahero for section and detail design ideas.",
      "quote": null,
      "at": null,
      "tags": [
        "website sections",
        "design details",
        "design tools"
      ]
    },
    "insight:63294d4b10": {
      "id": "insight:63294d4b10",
      "type": "insight",
      "text": "Discover diverse background designs for websites.",
      "how": "Visit backgrounds.supply Freebies, Gradient Lab, and Super Visuals for background inspiration.",
      "quote": null,
      "at": null,
      "tags": [
        "backgrounds",
        "design tools"
      ]
    },
    "insight:afca5a24b0": {
      "id": "insight:afca5a24b0",
      "type": "insight",
      "text": "Seek general design inspiration from broad platforms.",
      "how": "Use Pinterest, Awwwards, and curated.design for overall design ideas.",
      "quote": null,
      "at": null,
      "tags": [
        "general design",
        "inspiration",
        "design tools"
      ]
    },
    "insight:888536748a": {
      "id": "insight:888536748a",
      "type": "insight",
      "text": "Source sound effects for UI elements from specialized sites.",
      "how": "Explore UI SFX and Bencho for sound inspiration.",
      "quote": null,
      "at": null,
      "tags": [
        "sound design",
        "UI/UX",
        "design tools"
      ]
    },
    "source:ae2fd0fdfb": {
      "id": "source:ae2fd0fdfb",
      "type": "source",
      "url": "https://www.instagram.com/reel/De4EwvahdMl/",
      "title": "6 sites to give AI taste",
      "author": "@itsmariahbrunner",
      "kind": "transcript",
      "addedAt": "2026-11-22T16:30:58.563Z"
    },
    "insight:4d7fe44d31": {
      "id": "insight:4d7fe44d31",
      "type": "insight",
      "text": "Use Prompt Motion to find motion graphics with accompanying prompts and skills to guide AI.",
      "how": null,
      "quote": null,
      "at": null,
      "tags": [
        "Tool",
        "Motion Graphics",
        "AI Prompting"
      ]
    },
    "insight:eedef2d371": {
      "id": "insight:eedef2d371",
      "type": "insight",
      "text": "Leverage Eyecandy for creative video techniques, using its examples and effect names to precisely describe desired outcomes to AI.",
      "how": null,
      "quote": null,
      "at": null,
      "tags": [
        "Tool",
        "Video Editing",
        "AI Prompting"
      ]
    },
    "insight:40da379e69": {
      "id": "insight:40da379e69",
      "type": "insight",
      "text": "Explore React Bits for useful animated texts, backgrounds, and website components to inform AI design choices.",
      "how": null,
      "quote": null,
      "at": null,
      "tags": [
        "Tool",
        "Web Design",
        "Animation"
      ]
    },
    "insight:aad010b8ee": {
      "id": "insight:aad010b8ee",
      "type": "insight",
      "text": "Consult Motion Sites for different website designs with prompts to use as starting points for AI-generated layouts.",
      "how": null,
      "quote": null,
      "at": null,
      "tags": [
        "Tool",
        "Web Design",
        "AI Prompting"
      ]
    },
    "insight:1ff82b3fb1": {
      "id": "insight:1ff82b3fb1",
      "type": "insight",
      "text": "Refer to Savee for visual references when you have a general idea of wanting something good but lack a specific visual direction.",
      "how": null,
      "quote": null,
      "at": null,
      "tags": [
        "Tool",
        "Design Inspiration",
        "Visual Reference"
      ]
    },
    "insight:5bed5eef30": {
      "id": "insight:5bed5eef30",
      "type": "insight",
      "text": "Study launch films, animations, and motion designs on Motionographer to enhance AI's understanding of sophisticated motion design.",
      "how": null,
      "quote": null,
      "at": null,
      "tags": [
        "Tool",
        "Motion Design",
        "Animation"
      ]
    },
    "insight:05e134356c": {
      "id": "insight:05e134356c",
      "type": "insight",
      "text": "Upload a few chosen references to your preferred AI tool and be very specific about what you like about them to guide the AI effectively.",
      "how": null,
      "quote": null,
      "at": null,
      "tags": [
        "AI Prompting",
        "Specificity",
        "Reference"
      ]
    }
  },
